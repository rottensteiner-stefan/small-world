precision highp float;

varying vec3 v_worldPos;
varying vec3 v_normal;
varying vec2 v_uv;

[LIGHT_DEFS]

uniform vec3 u_viewPos;
uniform vec4 u_color;
uniform vec4 u_specColor;
uniform vec2 u_texOffset;
uniform vec2 u_texRepeat;
uniform float u_shininess;
uniform float u_isSkinned;
uniform float u_boneOffset;
uniform float u_pad1;
uniform float u_isTerrain;
uniform float u_metallic;
uniform float u_roughness;
uniform float u_useEnvMap;
uniform float u_useReflectionMap;
uniform float u_pad2;
uniform float u_pad3;
uniform float u_time;
uniform sampler2D u_opaqueMap;

[LIQUID_WORLEY_NOISE]

void main() {
    vec3 shallowColor = pow(u_color.rgb, vec3(2.2));
    vec3 deepColor = pow(u_specColor.rgb, vec3(2.2));
    vec3 edgeColor = pow(vec3(u_texOffset.x, u_texOffset.y, u_texRepeat.x), vec3(2.2));
    float edgeSoftness = max(u_texRepeat.y, 0.001);
    float foamDistance = max(u_pad3, 0.001);

    vec2 refractionUv = clamp(v_uv + v_normal.xz * u_shininess, vec2(0.001), vec2(0.999));
    vec3 refractedColor = texture2D(u_opaqueMap, refractionUv).rgb;
    refractedColor = pow(refractedColor, vec3(2.2));

    vec3 viewDir = normalize(u_viewPos - v_worldPos);
    float fresnel = pow(1.0 - clamp(dot(v_normal, viewDir), 0.0, 1.0), 4.0);

    // Procedural Caustics
    float causticsSpeed = u_pad2 * 0.75;
    vec2 causticsUv1 = v_worldPos.xz * (u_useReflectionMap * 0.85) + vec2(u_time * causticsSpeed, u_time * causticsSpeed * 0.5);
    vec2 causticsUv2 = v_worldPos.xz * (u_useReflectionMap * 1.1) - vec2(u_time * causticsSpeed * 0.6, u_time * causticsSpeed * 0.8);
    float caustics1 = 1.0 - waterCellNoise(causticsUv1);
    float caustics2 = 1.0 - waterCellNoise(causticsUv2);
    float causticsThreshold = 0.42;
    float causticsStep = step(causticsThreshold, caustics1 * caustics2);
    float causticsFade = 1.0 - smoothstep(0.0, 1.0, fresnel);
    vec3 finalCaustics = vec3(causticsStep) * causticsFade * vec3(1.0, 0.98, 0.88) * 1.2;

    vec3 illuminatedUnderwater = refractedColor + finalCaustics;

    vec3 waterAbsorption = vec3(u_isSkinned, u_boneOffset, u_pad1);
    vec3 transmittance = exp(-fresnel * 10.0 * waterAbsorption);
    vec3 tintedSeabed = illuminatedUnderwater * shallowColor;
    vec3 baseColor = mix(deepColor, tintedSeabed, transmittance);

    vec3 skyColor = vec3(0.65, 0.85, 1.0);
    baseColor = mix(baseColor, skyColor, fresnel * 0.45);

    vec3 lightDir = normalize(u_dirLightDir);
    vec3 halfVector = normalize(lightDir + viewDir);
    float nDotH = clamp(dot(v_normal, halfVector), 0.0, 1.0);
    float specular = step(0.92, nDotH) * 1.2;
    baseColor += u_dirLightColor * specular;

    float edgeBlend = pow(1.0 - fresnel, 1.0 / edgeSoftness);
    vec3 surfaceColor = mix(baseColor, edgeColor, edgeBlend * 0.7);

    // Toon Foam
    vec3 foamColor = pow(vec3(u_isTerrain, u_metallic, u_roughness), vec3(2.2));
    float foamCutoff = u_useEnvMap;
    float foamScale = u_useReflectionMap;
    float foamSpeed = u_pad2;
    float foamBlend = pow(1.0 - fresnel, 1.0 / foamDistance);
    vec2 foamUv1 = v_worldPos.xz * foamScale + vec2(u_time * foamSpeed, u_time * foamSpeed * 0.4);
    vec2 foamUv2 = v_worldPos.xz * (foamScale * 1.4) - vec2(u_time * foamSpeed * 0.5, u_time * foamSpeed * 0.8);
    float noise1 = 1.0 - waterCellNoise(foamUv1);
    float noise2 = 1.0 - waterCellNoise(foamUv2);
    float finalShoreFoam = step(foamCutoff, (noise1 * noise2) * foamBlend);

    float crestIntensity = smoothstep(0.92, 0.75, v_normal.y);
    float finalCrestFoam = step(foamCutoff * 0.85, noise1 * crestIntensity);

    float totalFoam = max(finalShoreFoam, finalCrestFoam);
    vec3 finalColor = mix(surfaceColor, foamColor, totalFoam);

    finalColor = pow(finalColor, vec3(1.0 / 2.2));
    gl_FragColor = vec4(finalColor, 1.0);
}
