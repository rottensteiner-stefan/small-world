precision highp float;

varying vec3 v_worldPos;
varying vec3 v_normal;
varying vec2 v_uv;
varying float v_crest;

[LIGHT_DEFS]

uniform vec3 u_viewPos;
uniform vec4 u_color;
uniform vec4 u_specColor;
uniform vec2 u_texOffset;
uniform vec2 u_texRepeat;
uniform float u_shininess; // repurposed: refractionStrength (see OpenWaterMaterial.ts)
uniform float u_isSkinned; // repurposed: waterAbsorption.r
uniform float u_boneOffset; // repurposed: waterAbsorption.g
uniform float u_pad1; // repurposed: waterAbsorption.b
uniform float u_isTerrain; // repurposed: foamColor.r
uniform float u_metallic; // repurposed: foamColor.g
uniform float u_roughness; // repurposed: foamColor.b
uniform float u_useEnvMap; // repurposed: foamCutoff
uniform float u_useReflectionMap; // repurposed: foamNoiseScale
uniform float u_pad2; // repurposed: foamNoiseSpeed
uniform float u_pad3; // repurposed: foamDistance
uniform float u_time;
uniform sampler2D u_opaqueMap;

[LIQUID_WORLEY_NOISE]

// WebGL1 has no depth-texture capture path (see WebGL1Renderer.copyToOpaqueDepthTexture),
// so the depth-based underwater fade from OpenWater.frag.wgsl/.frag.glsl is approximated
// with a Fresnel mix instead -- same simplification tradeoff as Glass.frag.glsl100 dropping
// TBN normal mapping. The opaque *color* capture IS available on WebGL1 though (see
// WebGL1Renderer.copyToOpaqueTexture), so refraction still works -- distorted with the mesh UV
// as a screen-space stand-in, same approximation Glass.frag.glsl100 already uses (GLSL ES 100 has
// no textureSize()/gl_FragCoord-normalization to get a real screen UV).
void main() {
    vec3 waterColor = pow(u_color.rgb, vec3(2.2));
    vec3 deepWaterColor = pow(u_specColor.rgb, vec3(2.2));

    vec3 edgeColor = vec3(u_texOffset.x, u_texOffset.y, u_texRepeat.x);
    float edgeSoftness = max(u_texRepeat.y, 0.001);
    float foamDistance = max(u_pad3, 0.001);

    vec2 refractionUv = clamp(v_uv + v_normal.xz * u_shininess, vec2(0.001), vec2(0.999));
    vec3 refractedColor = texture2D(u_opaqueMap, refractionUv).rgb;
    refractedColor = pow(refractedColor, vec3(2.2));

    vec3 viewDir = normalize(u_viewPos - v_worldPos);
    float fresnel = pow(1.0 - clamp(dot(v_normal, viewDir), 0.0, 1.0), 5.0);

    // No real depth buffer on WebGL1 (see comment above), so `fresnel` doubles as the "how deep
    // does this pixel look" proxy that OpenWater.frag.glsl/.wgsl get from the real depth capture.
    // Scaled by 10 to land in roughly the same absorption range as those depth-based versions.
    vec3 waterAbsorption = vec3(u_isSkinned, u_boneOffset, u_pad1);
    vec3 transmittance = exp(-fresnel * 10.0 * waterAbsorption);
    vec3 tintedSeabed = refractedColor * waterColor;
    vec3 inScatterCol = mix(waterColor, deepWaterColor, 0.35) * 0.15;
    vec3 underwaterLighting = tintedSeabed * transmittance + inScatterCol * (1.0 - transmittance);
    vec3 baseColor = mix(deepWaterColor, underwaterLighting, transmittance);

    vec3 skyColor = vec3(0.6, 0.8, 1.0);
    baseColor = mix(baseColor, skyColor, fresnel * 0.5);

    vec3 lightDir = normalize(u_dirLightDir);
    vec3 halfVector = normalize(lightDir + viewDir);
    float nDotH = clamp(dot(v_normal, halfVector), 0.0, 1.0);
    float specular = pow(nDotH, 100.0) * 1.5;
    baseColor += u_dirLightColor * specular;

    float edgeBlend = pow(1.0 - fresnel, 1.0 / max(edgeSoftness, 0.001));
    vec3 edgeColLinear = pow(edgeColor, vec3(2.2));
    vec3 finalColor = mix(baseColor, edgeColLinear, edgeBlend * 0.3);

    // Procedural foam: a Worley-noise pattern drifting in world-space XZ, masked to its own
    // shoreline/intersection band (foamDistance) instead of edgeBlend -- same "no real depth
    // buffer on WebGL1" fresnel-proxy tradeoff as edgeBlend above, but with its own independently
    // tunable falloff exponent so foam width doesn't have to match the color-edge width.
    vec3 foamColor = pow(vec3(u_isTerrain, u_metallic, u_roughness), vec3(2.2));
    float foamCutoff = u_useEnvMap;
    float foamNoiseScale = u_useReflectionMap;
    float foamNoiseSpeed = u_pad2;
    // No depth buffer on WebGL1: the old pow(1 - fresnel, ..) proxy is ~1 everywhere when seen from
    // above, which turned the whole pool into a white blob field. Fresnel is the only "far shore"
    // proxy we have, so shore foam now fades in only at grazing angles (same fix as StylizedWater).
    float foamBlend = smoothstep(0.02, 0.02 + 0.3 * foamDistance, fresnel);
    vec2 foamUv = v_worldPos.xz * foamNoiseScale + u_time * foamNoiseSpeed;
    float foamCell = waterCellNoise(foamUv);
    float foamPattern = 1.0 - smoothstep(foamCutoff, foamCutoff + 0.15, foamCell);

    // Splash pulse: modulates intersection foam intensity over time instead of a static band, so
    // it reads as water repeatedly slapping the object rather than a painted-on ring. Traveling
    // in wave1's rough direction (baked in as a constant here, not a uniform -- re-deriving the
    // exact vertex-shader phase would mean duplicating its wave uniforms into the fragment stage).
    float splashPhase = dot(normalize(vec2(1.0, 0.4)), v_worldPos.xz) * 0.8 - u_time * 1.6;
    float splashPulse = 0.6 + 0.4 * sin(splashPhase);
    float foamMask = foamPattern * foamBlend * splashPulse;

    // Wave-crest foam: v_crest is the vertex-shader Jacobian (wave-folding) metric, 0 on flat
    // water -> 1 where the Gerstner crests pinch together (replaces the parked normal.y
    // threshold, which only picked up high-frequency curvature noise). smoothstep (no step)
    // keeps the edge soft/alias-free; the existing Worley pattern breaks it into patches, and
    // it's gated so it never fully covers the crest line.
    float crestFoam = smoothstep(0.4, 0.7, v_crest) * foamPattern * 0.9;
    foamMask = max(foamMask, crestFoam);

    finalColor = mix(finalColor, foamColor, foamMask);

    // Procedural caustics: a lighter second Worley-noise layer.
    vec2 causticsUv1 = (v_worldPos.xz + v_normal.xz * 0.25) * foamNoiseScale * 0.75 + vec2(u_time * foamNoiseSpeed * 0.35, u_time * foamNoiseSpeed * 0.2);
    vec2 causticsUv2 = (v_worldPos.xz - v_normal.xz * 0.2) * foamNoiseScale * 1.05 - vec2(u_time * foamNoiseSpeed * 0.25, u_time * foamNoiseSpeed * 0.4);
    float caustics1 = 1.0 - waterCellNoise(causticsUv1);
    float caustics2 = 1.0 - waterCellNoise(causticsUv2);
    float causticsValue = pow(caustics1 * caustics2, 1.6) * 3.2;
    float causticsFade = 1.0 - smoothstep(0.0, 1.0, fresnel);
    finalColor += vec3(1.0, 0.98, 0.88) * causticsValue * causticsFade * 0.4;

    finalColor = pow(finalColor, vec3(1.0 / 2.2));

    gl_FragColor = vec4(finalColor, 1.0);
}
