[BASE_FS_HEADER]
[LIGHT_DEFS]
[PBR_MATH]

uniform float u_metallic;
uniform float u_roughness;
uniform float u_ao;

uniform sampler2D u_diffuseMap;
uniform sampler2D u_normalMap;
uniform sampler2D u_metallicMap;
uniform sampler2D u_roughnessMap;

void main() {
    vec4 texColor = texture2D(u_diffuseMap, v_uv);
    vec3 albedo = sRGBToLinear(texColor.rgb) * sRGBToLinear(u_color.rgb);
    
    float metallic = u_metallic * texture2D(u_metallicMap, v_uv).r;
    float roughness = clamp(u_roughness * texture2D(u_roughnessMap, v_uv).r, 0.05, 1.0);
    float ao = u_ao;

    [LIGHT_CALC_PBR]
}