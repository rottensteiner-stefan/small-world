{
  "name": "small-world",
  "version": "0.63.0",
  "description": "A lightweight 3D engine for hybrid WebGL2/WebGPU rendering pipelines.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "npm-run-all build:showcases build:lib",
    "build:showcases": "vite build && cp -a dist/public/. dist/ && rm -rf dist/public",
    "build:lib": "vite build --config vite.lib.config.ts",
    "changelog": "node scripts/generate-changelog.js",
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' vite --host",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint .",
    "lint:wgsl": "tsx scripts/lint-wgsl.ts",
    "lint:fix": "eslint . --fix",
    "prebuild": "node scripts/update-version.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:showcases": "node scripts/check-showcases.js",
    "start": "npm run build && npx serve dist",
    "prepare": "husky",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:api": "typedoc",
    "docs:build-all": "npm run docs:api && npm run docs:build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.9.1",
    "@vitest/ui": "^4.1.8",
    "@webgpu/types": "^0.1.70",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "puppeteer": "^25.1.0",
    "serve": "^14.2.6",
    "simplex-noise": "^4.0.3",
    "terser": "^5.48.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.22.4",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-mkcert": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8",
    "vue": "^3.5.38",
    "wgsl_reflect": "^1.4.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@kitschpatrol/tweakpane-plugin-camerakit": "^0.3.1-beta.3",
    "gl-matrix": "^3.4.4",
    "joy-con-webhid": "^0.11.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "tweakpane": "^4.0.5"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.wgsl": [
      "npm run lint:wgsl"
    ]
  }
}
