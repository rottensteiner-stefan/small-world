{
  "name": "small-world",
  "version": "0.20.02",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:demo build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "changelog": "node scripts/generate-changelog.js",
    "dev": "vite --host",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "node scripts/update-version.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "start": "npm run build && npx serve dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.6.2",
    "@vitest/ui": "^4.1.5",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "serve": "^14.2.6",
    "simplex-noise": "^4.0.3",
    "terser": "^5.47.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-mkcert": "^2.0.0",
    "vitest": "^4.1.5"
  }
}
