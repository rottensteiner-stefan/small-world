{
  "name": "small-world",
  "version": "0.35.1",
  "description": "A very small 3D engine focusing on raw WebGL performance",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:demo build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "changelog": "node scripts/generate-changelog.js",
    "dev": "vite --host",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint .",
    "lint:wgsl": "tsx scripts/lint-wgsl.ts",
    "lint:fix": "eslint . --fix",
    "prebuild": "node scripts/update-version.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "start": "npm run build && npx serve dist",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/node": "^25.9.1",
    "@vitest/ui": "^4.1.8",
    "@webgpu/types": "^0.1.70",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "puppeteer": "^25.1.0",
    "serve": "^14.2.6",
    "simplex-noise": "^4.0.3",
    "terser": "^5.48.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-mkcert": "^2.0.0",
    "vitest": "^4.1.8",
    "wgsl_reflect": "^1.4.0"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "joy-con-webhid": "^0.11.0",
    "pngjs": "^7.0.0",
    "tweakpane": "^4.0.5"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.wgsl": [
      "npm run lint:wgsl"
    ]
  }
}
