{
  "name": "small-world",
  "version": "0.12.01",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:demo build:lib",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "changelog": "node scripts/generate-changelog.js",
    "dev": "vite",
    "format": "prettier --write . && eslint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prebuild": "node scripts/update-version.js",
    "preview": "vite preview",
    "start": "npm run build && npx serve ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@microsoft/api-extractor": "^7.57.7",
    "@types/node": "^25.5.0",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.4.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "serve": "^14.2.6",
    "simplex-noise": "^4.0.1",
    "terser": "^5.46.0",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}
