# Schuhschachtel-Auto (Low-Poly)
mtllib car.mtl

# ==========================================
# 1. KAROSSERIE (Die große untere Schachtel)
# ==========================================
v -1.0 0.5  2.0
v  1.0 0.5  2.0
v  1.0 1.5  2.0
v -1.0 1.5  2.0
v -1.0 0.5 -2.0
v  1.0 0.5 -2.0
v  1.0 1.5 -2.0
v -1.0 1.5 -2.0

usemtl BodyPaint
f 1 2 3 4
f 6 5 8 7
f 4 3 7 8
f 5 6 2 1
f 2 6 7 3
f 5 1 4 8

# ==========================================
# 2. FAHRGASTZELLE (Die kleinere Schachtel oben drauf)
# ==========================================
v -0.8 1.5  1.0
v  0.8 1.5  1.0
v  0.8 2.2  1.0
v -0.8 2.2  1.0
v -0.8 1.5 -1.0
v  0.8 1.5 -1.0
v  0.8 2.2 -1.0
v -0.8 2.2 -1.0

# Das Dach kriegt Autofarbe
usemtl BodyPaint
f 12 11 15 16

# Die 4 Seiten werden zu blauen Fenstern
usemtl WindowGlass
f 9 10 11 12
f 14 13 16 15
f 10 14 15 11
f 13 9 12 16

# ==========================================
# 3. RÄDER (4 einfache Schachteln)
# ==========================================
# Rad Vorne Links (Punkte 17-24)
v  0.9 0.1  1.8
v  1.3 0.1  1.8
v  1.3 0.9  1.8
v  0.9 0.9  1.8
v  0.9 0.1  1.0
v  1.3 0.1  1.0
v  1.3 0.9  1.0
v  0.9 0.9  1.0

# Rad Vorne Rechts (Punkte 25-32)
v -1.3 0.1  1.8
v -0.9 0.1  1.8
v -0.9 0.9  1.8
v -1.3 0.9  1.8
v -1.3 0.1  1.0
v -0.9 0.1  1.0
v -0.9 0.9  1.0
v -1.3 0.9  1.0

# Rad Hinten Links (Punkte 33-40)
v  0.9 0.1 -1.0
v  1.3 0.1 -1.0
v  1.3 0.9 -1.0
v  0.9 0.9 -1.0
v  0.9 0.1 -1.8
v  1.3 0.1 -1.8
v  1.3 0.9 -1.8
v  0.9 0.9 -1.8

# Rad Hinten Rechts (Punkte 41-48)
v -1.3 0.1 -1.0
v -0.9 0.1 -1.0
v -0.9 0.9 -1.0
v -1.3 0.9 -1.0
v -1.3 0.1 -1.8
v -0.9 0.1 -1.8
v -0.9 0.9 -1.8
v -1.3 0.9 -1.8

usemtl WheelRubber
# VL
f 17 18 19 20
f 22 21 24 23
f 20 19 23 24
f 21 22 18 17
f 18 22 23 19
f 21 17 20 24
# VR
f 25 26 27 28
f 30 29 32 31
f 28 27 31 32
f 29 30 26 25
f 26 30 31 27
f 29 25 28 32
# HL
f 33 34 35 36
f 38 37 40 39
f 36 35 39 40
f 37 38 34 33
f 34 38 39 35
f 37 33 36 40
# HR
f 41 42 43 44
f 46 45 48 47
f 44 43 47 48
f 45 46 42 41
f 42 46 47 43
f 45 41 44 48

# ==========================================
# 4. ZIERKAPPEN / FELGEN
# ==========================================
v  1.31 0.3  1.6
v  1.31 0.3  1.2
v  1.31 0.7  1.2
v  1.31 0.7  1.6

v -1.31 0.3  1.2
v -1.31 0.3  1.6
v -1.31 0.7  1.6
v -1.31 0.7  1.2

v  1.31 0.3 -1.2
